# Block all direct HTTP access to this folder (entries.json, passwords.json).
# PHP (api/*.php) still needs and retains filesystem access — only the web
# server's direct static-file serving of this directory is denied.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
